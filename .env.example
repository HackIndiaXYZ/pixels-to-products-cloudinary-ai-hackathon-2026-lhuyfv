# FEATHERLESS_API_KEY: Required for Featherless AI Vision API calls (free tier available).
# Get your free API key from https://featherless.ai
FEATHERLESS_API_KEY="your_featherless_api_key"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloudinary Credentials (Server-side only)
# Sign up at https://cloudinary.com for a free account.
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
